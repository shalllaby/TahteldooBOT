/* ═══════════════════════════════════════════════════════════════════
   جريدة تحت الضوء الإخبارية — Modern Light Mode Theme
   PySide6 QSS Design System v2.0 (Light Variant)
   ═══════════════════════════════════════════════════════════════════ */

/* ─── Global Base Settings ─── */
* {
    font-family: 'Segoe UI', 'Cairo', 'SF Pro Text', Tahoma, sans-serif;
    outline: none;
}

QMainWindow {
    background-color: #f1f5f9;
}

QWidget {
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
}

QToolTip {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ─── Sidebar Navigation ─── */
#sidebar {
    background-color: #ffffff;
    border-left: 1px solid #e2e8f0;
    min-width: 240px;
    max-width: 240px;
}

#brand_avatar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0284c7, stop:1 #2563eb);
    border-radius: 12px;
    color: #ffffff;
    font-weight: bold;
    font-size: 16px;
    padding: 8px;
}

#nav_title {
    font-size: 17px;
    font-weight: 800;
    color: #0f172a;
    padding: 4px 0 2px 0;
}

#nav_version {
    font-size: 11px;
    color: #64748b;
    font-weight: 500;
}

#sidebar_header {
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
    padding: 12px 18px 6px 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Navigation Item Buttons */
QPushButton[class="nav-btn"] {
    background-color: transparent;
    color: #475569;
    border: none;
    padding: 12px 18px;
    text-align: right;
    font-size: 13px;
    font-weight: 600;
    border-radius: 10px;
    margin: 3px 10px;
}

QPushButton[class="nav-btn"]:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QPushButton[class="nav-btn"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #e0f2fe, stop:1 #e0e7ff);
    color: #0284c7;
    border-right: 4px solid #0284c7;
    font-weight: 700;
}

/* Status Chips */
QLabel[class="status-chip-ok"] {
    background-color: #dcfce7;
    color: #15803d;
    border: 1px solid #86efac;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[class="status-chip-info"] {
    background-color: #e0f2fe;
    color: #0369a1;
    border: 1px solid #7dd3fc;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel[class="status-chip-err"] {
    background-color: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ─── Buttons ─── */
QPushButton[class="primary-btn"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #2563eb);
    color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton[class="primary-btn"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0369a1, stop:1 #1d4ed8);
}

QPushButton[class="primary-btn"]:pressed {
    background-color: #075985;
}

QPushButton[class="primary-btn"]:disabled {
    background-color: #e2e8f0;
    color: #94a3b8;
    border-color: transparent;
}

QPushButton[class="secondary-btn"] {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[class="secondary-btn"]:hover {
    background-color: #f8fafc;
    border-color: #0284c7;
    color: #0284c7;
}

QPushButton[class="secondary-btn"]:pressed {
    background-color: #e2e8f0;
}

QPushButton[class="danger-btn"] {
    background-color: #ef4444;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton[class="danger-btn"]:hover {
    background-color: #dc2626;
}

QPushButton[class="success-btn"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #059669, stop:1 #10b981);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton[class="success-btn"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #047857, stop:1 #059669);
}

/* ─── Text Inputs & Editors ─── */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 2px solid #0284c7;
    background-color: #ffffff;
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: #94a3b8;
}

/* ─── Cards & Containers ─── */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    margin-top: 14px;
    padding: 22px 16px 16px 16px;
    font-weight: 700;
    font-size: 13px;
    color: #334155;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 2px 14px;
    color: #0284c7;
    font-size: 13px;
    font-weight: 700;
}

/* ─── Headings & Typography ─── */
QLabel[class="section-title"] {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    padding-bottom: 2px;
}

QLabel[class="section-subtitle"] {
    font-size: 13px;
    color: #64748b;
    padding-bottom: 6px;
    line-height: 1.5;
}

/* ─── Radio Buttons & Checkboxes ─── */
QRadioButton, QCheckBox {
    color: #334155;
    spacing: 8px;
    font-size: 13px;
    font-weight: 500;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: #0284c7;
    border-color: #0284c7;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #0284c7;
    border-color: #0284c7;
}

/* ─── Entity Type Selector Pills ─── */
QRadioButton[class="entity-pill"] {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 14px;
    color: #475569;
}

QRadioButton[class="entity-pill"]:checked {
    background-color: #e0f2fe;
    border-color: #0284c7;
    color: #0284c7;
    font-weight: 700;
}

/* ─── Data Tables ─── */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    gridline-color: #f1f5f9;
    color: #1e293b;
    font-size: 13px;
}

QTableWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid #f1f5f9;
}

QTableWidget::item:selected {
    background-color: #e0f2fe;
    color: #0f172a;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #475569;
    padding: 12px 14px;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 2px solid #cbd5e1;
}

/* ─── Progress Bar ─── */
QProgressBar {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    text-align: center;
    color: #0f172a;
    font-size: 12px;
    font-weight: 600;
    min-height: 24px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #2563eb);
    border-radius: 7px;
}

/* ─── Scroll Bars ─── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #0284c7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0;
}

/* ─── Splitter Handle ─── */
QSplitter::handle {
    background-color: #e2e8f0;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #0284c7;
}

/* ─── Tab Widget Styling ─── */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background-color: #ffffff;
    padding: 16px;
    top: -1px;
}

QTabBar::tab {
    background-color: #f8fafc;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 13px;
    margin-left: 4px;
}

QTabBar::tab:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0284c7;
    border: 1px solid #0284c7;
    border-bottom: 3px solid #0284c7;
}
